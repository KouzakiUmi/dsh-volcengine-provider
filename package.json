{
  "name": "dsh-volcengine-provider",
  "displayName": "火山方舟 Provider",
  "version": "0.2.23",
  "description": "火山方舟 Agent Plan 与 Coding Plan：账号、模型与额度管理，支持 Seedream 透明图片和图层拆分。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-volcengine-provider.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-volcengine-provider#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-volcengine-provider/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "volcengine",
    "arkcli",
    "coding-plan",
    "agent-plan",
    "oauth"
  ],
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "check": "node scripts/check.mjs && node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@earendil-works/pi-ai": ">=1.1.0 <2.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.4 <0.3.0 || >=0.2.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
